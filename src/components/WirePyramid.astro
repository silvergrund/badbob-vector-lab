---
type Point3D = readonly [number, number, number];
const vertices: readonly Point3D[] = [
    [25, 25, 25],
    [25, -25, -25],
    [-25, 25, -25],
    [-25, -25, 25],
];
const connections = [[0, 1], [0, 2], [0, 3], [1, 2], [1, 3], [2, 3]] as const;
const edges = connections.map(([start, end]) => {
    const a = vertices[start];
    const b = vertices[end];
    const [dx, dy, dz] = b.map((value, index) => value - a[index]);
    const length = Math.hypot(dx, dy, dz);
    const azimuth = Math.atan2(dy, dx) * 180 / Math.PI;
    const elevation = -Math.atan2(dz, Math.hypot(dx, dy)) * 180 / Math.PI;
    const midpoint = a.map((value, index) => (value + b[index]) / 2);

    return `width:${length}cqi;transform:translate3d(${midpoint[0]}cqi,${midpoint[1]}cqi,${midpoint[2]}cqi) rotateZ(${azimuth}deg) rotateY(${elevation}deg)`;
});
---
<div class="wire-pyramid" aria-hidden="true">
    <div class="pyramid-mesh">
        {edges.map(style => <span class="pyramid-edge" style={style}></span>)}
    </div>
</div>
<style>
    .wire-pyramid{position:relative;inline-size:100%;aspect-ratio:1;container-type:inline-size;perspective:700px;pointer-events:none}
    .pyramid-mesh{position:absolute;inset:0;transform-style:preserve-3d;transform:rotateX(-14deg) rotateY(20deg);animation:pyramid-turn var(--shape-duration,30s) linear infinite;animation-direction:var(--shape-direction,normal)}
    .pyramid-edge{position:absolute;left:50%;top:50%;translate:-50% -50%;block-size:0;border-top:1px solid currentColor;backface-visibility:visible}
    @keyframes pyramid-turn{from{transform:rotateX(-14deg) rotateY(20deg)}to{transform:rotateX(346deg) rotateY(-340deg)}}
    @media(prefers-reduced-motion:reduce){.pyramid-mesh{animation:none}}
</style>
